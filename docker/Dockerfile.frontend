# ─── PesaGraph Angular Frontend – Multi-stage Dockerfile ─────────────────────
# Stage 1: Node build
FROM node:22-alpine AS build
WORKDIR /app

# Copy package manifests first for layer cache
COPY frontend/package*.json ./
RUN npm ci --prefer-offline

# Copy source and build production bundle
COPY frontend/ .
RUN npm run build -- --configuration production

# ─── Stage 2: Nginx runtime ──────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default nginx page
RUN rm -rf /usr/share/nginx/html/*

# Copy Angular build output
COPY --from=build /app/dist/pesagraph-frontend/browser /usr/share/nginx/html

# Custom nginx config: HTML5 push-state routing + gzip
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
