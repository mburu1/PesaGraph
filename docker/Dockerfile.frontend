# Multi-stage build for PesaGraph Angular Frontend
FROM node:22-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm ci --prefer-offline

COPY . .
RUN npm run build

# Production serving stage via Nginx
FROM nginx:alpine
COPY --from=build /app/dist/pesagraph-frontend/browser /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
