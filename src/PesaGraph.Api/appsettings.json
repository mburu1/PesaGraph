{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=pesagraph;Username=postgres;Password=postgres",
    "MaxRetryCount": 3,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "pesagraph_raw"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "PesaGraph:",
    "DefaultExpirationMinutes": 60
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "RetryLimit": 5,
    "InitialIntervalMs": 200,
    "IntervalIncrementMs": 200
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "GroupId": "pesagraph-consumer-group",
    "TransactionEventsTopic": "pesagraph.canonical.transactions"
  },
  "Providers": {
    "Daraja": {
      "ConsumerKey": "SandboxConsumerKey",
      "ConsumerSecret": "SandboxConsumerSecret",
      "PassKey": "SandboxPassKey",
      "ShortCode": "174379",
      "Environment": "Sandbox",
      "BaseUrl": "https://sandbox.safaricom.co.ke",
      "CallbackUrl": "https://your-domain.ngrok-free.app/api/v1/webhooks/mpesa",
      "TimeoutSeconds": 30
    },
    "AirtelMoney": {
      "ClientId": "SandboxAirtelClientId",
      "ClientSecret": "SandboxAirtelClientSecret",
      "Environment": "Sandbox",
      "BaseUrl": "https://openapiuat.airtel.africa",
      "CallbackUrl": "https://your-domain.ngrok-free.app/api/v1/webhooks/airtel",
      "TimeoutSeconds": 30
    },
    "WhatsApp": {
      "AccessToken": "EAAG...",
      "PhoneNumberId": "100000000000001",
      "BusinessAccountId": "200000000000002",
      "WebhookVerifyToken": "pesagraph_verify_token_secure",
      "BaseUrl": "https://graph.facebook.com/v21.0",
      "TimeoutSeconds": 20
    },
    "Sms": {
      "Provider": "AfricasTalking",
      "ApiKey": "atsk_sandbox_key",
      "Username": "sandbox",
      "SenderId": "PesaGraph",
      "BaseUrl": "https://api.africastalking.com/version1"
    }
  }
}
