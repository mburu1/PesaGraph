# PesaGraph environment variables
# Copy this file to .env and fill in your sandbox/prod credentials.
# Never commit the actual .env file (it is in .gitignore).

# ── ASP.NET Core ──────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ── Relational Database (PostgreSQL) ─────────────────────────────────────────
POSTGRES_PASSWORD=pesagraph_dev
# ConnectionStrings__Relational=Host=localhost;Database=pesagraph;Username=pesagraph;Password=pesagraph_dev

# ── Document Store (MongoDB) ──────────────────────────────────────────────────
MONGO_PASSWORD=pesagraph_dev
# ConnectionStrings__Document=mongodb://pesagraph:pesagraph_dev@localhost:27017/pesagraph?authSource=admin

# ── Cache / Coordination (Redis) ─────────────────────────────────────────────
# Redis__Connection=localhost:6379

# ── Messaging: RabbitMQ ───────────────────────────────────────────────────────
RABBITMQ_PASSWORD=pesagraph_dev
# RabbitMq__Connection=amqp://pesagraph:pesagraph_dev@localhost:5672/pesagraph

# ── Messaging: Kafka / Redpanda ───────────────────────────────────────────────
# Kafka__BootstrapServers=localhost:19092

# ── Provider: Safaricom Daraja 3.0 ────────────────────────────────────────────
DARAJA_CONSUMER_KEY=sandbox_key
DARAJA_CONSUMER_SECRET=sandbox_secret
# Daraja__BaseUrl=https://sandbox.safaricom.co.ke
# Daraja__ShortCode=174379
# Daraja__PassKey=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# ── Provider: Airtel Money ────────────────────────────────────────────────────
AIRTEL_CLIENT_ID=sandbox_id
AIRTEL_CLIENT_SECRET=sandbox_secret

# ── Provider: WhatsApp Business API ─────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=sandbox_token
WHATSAPP_PHONE_NUMBER_ID=sandbox_phone_id
# WhatsApp__WebhookVerifyToken=your_verify_token
# WhatsApp__BusinessAccountId=your_waba_id

# ── Provider: SMS Gateway ────────────────────────────────────────────────────
SMS_API_KEY=sandbox_key
# Sms__SenderId=PESAGRAPH
